# Example environment variables
# Copy this file to .env and fill in your actual values

# API Keys (sensitive - use GitHub secrets in CI)
DEEPSEED_API_KEY="your-deepseed-api-key"
# OPENAI_API_KEY="your-openai-api-key"

# Public configuration
VITE_API_HOST="https://www.glosc.ai"
VITE_SITE_HOST="https://www.glosc.ai"

# Firebase / Google Analytics
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Gateway and AI keys (sensitive)
AI_GATEWAY_API_KEY="your-ai-gateway-api-key"
GOOGLE_VertexAI_API_KEY="your-google-vertex-ai-key"
GOOGLE_VertexAI_PROJECT_ID="your-google-project-id"

# macOS 签名
APPLE_SIGNING_IDENTITY=""
APPLE_CERTIFICATE=""
APPLE_CERTIFICATE_PASSWORD=""
APPLE_INSTALLER_SIGNING_IDENTITY=""
APPLE_API_KEY_ID=""
APPLE_API_ISSUER=""
